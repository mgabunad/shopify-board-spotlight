{%- comment -%}
  Product spotlight — custom section for Bloom and Bare (Horizon theme)
  Author: Mayjhon Gabunada
  Adapted from Board spotlight (Frostline Boards).
  Features: product picker, variant buttons that update price and
  compare-at price, sale badge, image position setting, add-to-bag form,
  and benefit rating blocks.
{%- endcomment -%}

{%- liquid
  assign item = section.settings.product
  assign current_variant = item.selected_or_first_available_variant
  assign on_sale = false
  if current_variant.compare_at_price > current_variant.price
    assign on_sale = true
  endif
-%}

<section
  class="product-spotlight"
  id="ProductSpotlight-{{ section.id }}"
  style="--ps-accent: {{ section.settings.accent_color }}; --ps-pad-top: {{ section.settings.padding_top }}px; --ps-pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="product-spotlight__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="product-spotlight__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="product-spotlight__grid{% if section.settings.image_position == 'right' %} product-spotlight__grid--image-right{% endif %}">
      <div class="product-spotlight__media">
        <span
          class="product-spotlight__badge"
          data-badge
          {% unless on_sale %}
            hidden
          {% endunless %}
        >
          {{- section.settings.sale_label | escape -}}
        </span>

        {%- if item != blank and item.featured_image -%}
          {{
            item.featured_image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200',
              sizes: '(min-width: 750px) 50vw, 100vw',
              class: 'product-spotlight__image'
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'product-spotlight__placeholder' }}
        {%- endif -%}
      </div>

      <div class="product-spotlight__info">
        {%- if section.settings.label != blank -%}
          <p class="product-spotlight__label">{{ section.settings.label | escape }}</p>
        {%- endif -%}

        {%- if item == blank -%}
          <h3 class="product-spotlight__title">Choose a product</h3>
          <p class="product-spotlight__desc">Pick a product in the theme editor to show it here.</p>
        {%- else -%}
          <h3 class="product-spotlight__title">{{ item.title | escape }}</h3>

          <div class="product-spotlight__price-row">
            <span class="product-spotlight__price" data-price>{{ current_variant.price | money }}</span>
            <s
              class="product-spotlight__compare"
              data-compare
              {% unless on_sale %}
                hidden
              {% endunless %}
            >
              {{- current_variant.compare_at_price | money -}}
            </s>
          </div>

          {%- if section.settings.show_description and item.description != blank -%}
            <p class="product-spotlight__desc">{{ item.description | strip_html | truncatewords: 30 }}</p>
          {%- endif -%}
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="product-spotlight__benefits">
            {%- for block in section.blocks -%}
              <li class="product-spotlight__benefit" {{ block.shopify_attributes }}>
                <span class="product-spotlight__benefit-name">{{ block.settings.benefit_name | escape }}</span>
                <span class="product-spotlight__dots" aria-hidden="true">
                  {%- for i in (1..5) -%}
                    <span class="product-spotlight__dot{% if i <= block.settings.rating %} is-filled{% endif %}"></span>
                  {%- endfor -%}
                </span>
                <span class="product-spotlight__sr">{{ block.settings.rating }} out of 5</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if item != blank -%}
          {%- form 'product', item, class: 'product-spotlight__form' -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

            {%- unless item.has_only_default_variant -%}
              <p class="product-spotlight__option-name">{{ item.options.first | escape }}</p>
              <div class="product-spotlight__variants">
                {%- for variant in item.variants -%}
                  <button
                    type="button"
                    class="product-spotlight__variant{% if variant.id == current_variant.id %} is-active{% endif %}"
                    data-id="{{ variant.id }}"
                    data-price="{{ variant.price | money | escape }}"
                    data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}"
                    aria-pressed="{% if variant.id == current_variant.id %}true{% else %}false{% endif %}"
                    {% unless variant.available %}
                      disabled
                    {% endunless %}
                  >
                    {{ variant.title | escape }}
                  </button>
                {%- endfor -%}
              </div>
            {%- endunless -%}

            <button
              type="submit"
              class="product-spotlight__button"
              {% unless current_variant.available %}
                disabled
              {% endunless %}
            >
              {%- if current_variant.available -%}
                {{ section.settings.button_label | escape }}
              {%- else -%}
                Sold out
              {%- endif -%}
            </button>
          {%- endform -%}

          <a class="product-spotlight__link" href="{{ item.url }}">View full details</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    function initProductSpotlight(root) {
      if (!root || root.dataset.psInit === 'true') return;
      root.dataset.psInit = 'true';

      var input = root.querySelector('[data-variant-id]');
      var price = root.querySelector('[data-price]');
      var compare = root.querySelector('[data-compare]');
      var badge = root.querySelector('[data-badge]');
      var buttons = root.querySelectorAll('.product-spotlight__variant');

      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          buttons.forEach(function (b) {
            b.classList.remove('is-active');
            b.setAttribute('aria-pressed', 'false');
          });
          btn.classList.add('is-active');
          btn.setAttribute('aria-pressed', 'true');

          if (input) input.value = btn.dataset.id;
          if (price) price.textContent = btn.dataset.price;

          var compareValue = btn.dataset.compare;
          if (compare) {
            compare.textContent = compareValue;
            compare.hidden = !compareValue;
          }
          if (badge) badge.hidden = !compareValue;
        });
      });
    }

    initProductSpotlight(document.getElementById('ProductSpotlight-{{ section.id }}'));

    // Re-run when the section is edited in the theme editor
    if (!window.__productSpotlightListener) {
      window.__productSpotlightListener = true;
      document.addEventListener('shopify:section:load', function (event) {
        var root = event.target.querySelector('.product-spotlight');
        initProductSpotlight(root);
      });
    }
  })();
</script>

{% stylesheet %}
  .product-spotlight {
    padding-top: var(--ps-pad-top);
    padding-bottom: var(--ps-pad-bottom);
  }

  .product-spotlight [hidden] {
    display: none !important;
  }

  .product-spotlight__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .product-spotlight__heading {
    margin: 0 0 32px;
  }

  .product-spotlight__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 750px) {
    .product-spotlight__grid {
      grid-template-columns: 1fr 1fr;
      gap: 56px;
    }

    .product-spotlight__grid--image-right .product-spotlight__media {
      order: 2;
    }
  }

  .product-spotlight__media {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    background: rgba(127, 127, 127, 0.08);
  }

  .product-spotlight__image,
  .product-spotlight__placeholder {
    display: block;
    width: 100%;
    height: auto;
  }

  .product-spotlight__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 1;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--ps-accent);
    color: #fff;
    font-size: 0.85em;
    font-weight: 600;
  }

  .product-spotlight__label {
    margin: 0 0 8px;
    color: var(--ps-accent);
    font-weight: 600;
  }

  .product-spotlight__title {
    margin: 0 0 8px;
  }

  .product-spotlight__price-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 16px;
  }

  .product-spotlight__price {
    font-size: 1.25em;
    font-weight: 600;
  }

  .product-spotlight__compare {
    opacity: 0.6;
  }

  .product-spotlight__desc {
    margin: 0 0 24px;
    max-width: 60ch;
    opacity: 0.85;
  }

  .product-spotlight__benefits {
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .product-spotlight__benefit {
    display: grid;
    grid-template-columns: 110px 1fr;
    align-items: center;
    gap: 12px;
  }

  .product-spotlight__benefit-name {
    font-weight: 600;
  }

  .product-spotlight__dots {
    display: flex;
    gap: 6px;
  }

  .product-spotlight__dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1.5px solid var(--ps-accent);
    background: transparent;
  }

  .product-spotlight__dot.is-filled {
    background: var(--ps-accent);
  }

  .product-spotlight__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .product-spotlight__option-name {
    margin: 0 0 8px;
    font-weight: 600;
  }

  .product-spotlight__variants {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .product-spotlight__variant {
    padding: 10px 18px;
    border: 1px solid rgba(127, 127, 127, 0.4);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .product-spotlight__variant.is-active {
    border-color: var(--ps-accent);
    box-shadow: inset 0 0 0 1px var(--ps-accent);
  }

  .product-spotlight__variant:disabled {
    opacity: 0.4;
    text-decoration: line-through;
    cursor: not-allowed;
  }

  .product-spotlight__button {
    width: 100%;
    padding: 14px 20px;
    border: 0;
    border-radius: 999px;
    background: var(--ps-accent);
    color: #fff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .product-spotlight__button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .product-spotlight__variant:focus-visible,
  .product-spotlight__button:focus-visible,
  .product-spotlight__link:focus-visible {
    outline: 2px solid var(--ps-accent);
    outline-offset: 2px;
  }

  .product-spotlight__link {
    display: inline-block;
    margin-top: 14px;
    color: inherit;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product spotlight",
  "tag": "section",
  "class": "section-product-spotlight",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product of the week"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Small label",
      "default": "Customer favourite"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show short description",
      "default": true
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position on desktop",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to bag"
    },
    {
      "type": "text",
      "id": "sale_label",
      "label": "Sale badge text",
      "default": "Sale"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#b5646e"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit rating",
      "settings": [
        {
          "type": "text",
          "id": "benefit_name",
          "label": "Benefit name",
          "default": "Hydration"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating (1–5)",
          "default": 4
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Product spotlight",
      "blocks": [
        { "type": "benefit", "settings": { "benefit_name": "Hydration", "rating": 5 } },
        { "type": "benefit", "settings": { "benefit_name": "Glow", "rating": 4 } },
        { "type": "benefit", "settings": { "benefit_name": "Gentleness", "rating": 5 } }
      ]
    }
  ]
}
{% endschema %}
