{%- comment -%}
  Board spotlight — custom section for Frostline Boards (Horizon theme)
  Author: Mayjhon Gabunada
  Features: product picker, variant buttons that update price,
  add-to-cart form, and schema blocks for 1–5 spec ratings.
{%- endcomment -%}

{%- liquid
  assign board = section.settings.product
  assign current_variant = board.selected_or_first_available_variant
-%}

<section
  class="board-spotlight"
  id="BoardSpotlight-{{ section.id }}"
  style="--bs-accent: {{ section.settings.accent_color }}; --bs-pad-top: {{ section.settings.padding_top }}px; --bs-pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="board-spotlight__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="board-spotlight__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="board-spotlight__grid">
      <div class="board-spotlight__media">
        {%- if board != blank and board.featured_image -%}
          {{
            board.featured_image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200',
              sizes: '(min-width: 750px) 50vw, 100vw',
              class: 'board-spotlight__image'
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'board-spotlight__placeholder' }}
        {%- endif -%}
      </div>

      <div class="board-spotlight__info">
        {%- if section.settings.label != blank -%}
          <p class="board-spotlight__label">{{ section.settings.label | escape }}</p>
        {%- endif -%}

        {%- if board == blank -%}
          <h3 class="board-spotlight__title">Choose a board</h3>
          <p class="board-spotlight__desc">Pick a product in the theme editor to show it here.</p>
        {%- else -%}
          <h3 class="board-spotlight__title">{{ board.title | escape }}</h3>
          <p class="board-spotlight__price" data-price>{{ current_variant.price | money }}</p>

          {%- if section.settings.show_description and board.description != blank -%}
            <p class="board-spotlight__desc">{{ board.description | strip_html | truncatewords: 30 }}</p>
          {%- endif -%}
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="board-spotlight__specs">
            {%- for block in section.blocks -%}
              <li class="board-spotlight__spec" {{ block.shopify_attributes }}>
                <span class="board-spotlight__spec-name">{{ block.settings.spec_name | escape }}</span>
                <span class="board-spotlight__meter" aria-hidden="true">
                  {%- for i in (1..5) -%}
                    <span class="board-spotlight__notch{% if i <= block.settings.rating %} is-filled{% endif %}"></span>
                  {%- endfor -%}
                </span>
                <span class="board-spotlight__sr">{{ block.settings.rating }} out of 5</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if board != blank -%}
          {%- form 'product', board, class: 'board-spotlight__form' -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

            {%- unless board.has_only_default_variant -%}
              <p class="board-spotlight__option-name">{{ board.options.first | escape }}</p>
              <div class="board-spotlight__variants">
                {%- for variant in board.variants -%}
                  <button
                    type="button"
                    class="board-spotlight__variant{% if variant.id == current_variant.id %} is-active{% endif %}"
                    data-id="{{ variant.id }}"
                    data-price="{{ variant.price | money | escape }}"
                    aria-pressed="{% if variant.id == current_variant.id %}true{% else %}false{% endif %}"
                    {% unless variant.available %}
                      disabled
                    {% endunless %}
                  >
                    {{ variant.title | escape }}
                  </button>
                {%- endfor -%}
              </div>
            {%- endunless -%}

            <button
              type="submit"
              class="board-spotlight__button"
              {% unless current_variant.available %}
                disabled
              {% endunless %}
            >
              {%- if current_variant.available -%}
                {{ section.settings.button_label | escape }}
              {%- else -%}
                Sold out
              {%- endif -%}
            </button>
          {%- endform -%}

          <a class="board-spotlight__link" href="{{ board.url }}">View full details</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    function initBoardSpotlight(root) {
      if (!root || root.dataset.bsInit === 'true') return;
      root.dataset.bsInit = 'true';

      var input = root.querySelector('[data-variant-id]');
      var price = root.querySelector('[data-price]');
      var buttons = root.querySelectorAll('.board-spotlight__variant');

      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          buttons.forEach(function (b) {
            b.classList.remove('is-active');
            b.setAttribute('aria-pressed', 'false');
          });
          btn.classList.add('is-active');
          btn.setAttribute('aria-pressed', 'true');
          if (input) input.value = btn.dataset.id;
          if (price) price.textContent = btn.dataset.price;
        });
      });
    }

    initBoardSpotlight(document.getElementById('BoardSpotlight-{{ section.id }}'));

    // Re-run when the section is edited in the theme editor
    if (!window.__boardSpotlightListener) {
      window.__boardSpotlightListener = true;
      document.addEventListener('shopify:section:load', function (event) {
        var root = event.target.querySelector('.board-spotlight');
        initBoardSpotlight(root);
      });
    }
  })();
</script>

{% stylesheet %}
  .board-spotlight {
    padding-top: var(--bs-pad-top);
    padding-bottom: var(--bs-pad-bottom);
  }

  .board-spotlight__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .board-spotlight__heading {
    margin: 0 0 32px;
  }

  .board-spotlight__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 750px) {
    .board-spotlight__grid {
      grid-template-columns: 1.1fr 1fr;
      gap: 56px;
    }
  }

  .board-spotlight__media {
    border-radius: 12px;
    overflow: hidden;
    background: rgba(127, 127, 127, 0.08);
  }

  .board-spotlight__image,
  .board-spotlight__placeholder {
    display: block;
    width: 100%;
    height: auto;
  }

  .board-spotlight__label {
    margin: 0 0 8px;
    color: var(--bs-accent);
    font-weight: 600;
  }

  .board-spotlight__title {
    margin: 0 0 8px;
  }

  .board-spotlight__price {
    margin: 0 0 16px;
    font-size: 1.25em;
    font-weight: 600;
  }

  .board-spotlight__desc {
    margin: 0 0 24px;
    max-width: 60ch;
    opacity: 0.85;
  }

  .board-spotlight__specs {
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .board-spotlight__spec {
    display: grid;
    grid-template-columns: 90px 1fr;
    align-items: center;
    gap: 12px;
  }

  .board-spotlight__spec-name {
    font-weight: 600;
  }

  .board-spotlight__meter {
    display: flex;
    gap: 4px;
  }

  .board-spotlight__notch {
    flex: 1;
    max-width: 44px;
    height: 8px;
    border-radius: 999px;
    background: rgba(127, 127, 127, 0.2);
  }

  .board-spotlight__notch.is-filled {
    background: var(--bs-accent);
  }

  .board-spotlight__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .board-spotlight__option-name {
    margin: 0 0 8px;
    font-weight: 600;
  }

  .board-spotlight__variants {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .board-spotlight__variant {
    padding: 10px 16px;
    border: 1px solid rgba(127, 127, 127, 0.4);
    border-radius: 8px;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .board-spotlight__variant.is-active {
    border-color: var(--bs-accent);
    box-shadow: inset 0 0 0 1px var(--bs-accent);
  }

  .board-spotlight__variant:disabled {
    opacity: 0.4;
    text-decoration: line-through;
    cursor: not-allowed;
  }

  .board-spotlight__button {
    width: 100%;
    padding: 14px 20px;
    border: 0;
    border-radius: 8px;
    background: var(--bs-accent);
    color: #fff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .board-spotlight__button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .board-spotlight__variant:focus-visible,
  .board-spotlight__button:focus-visible,
  .board-spotlight__link:focus-visible {
    outline: 2px solid var(--bs-accent);
    outline-offset: 2px;
  }

  .board-spotlight__link {
    display: inline-block;
    margin-top: 14px;
    color: inherit;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Board spotlight",
  "tag": "section",
  "class": "section-board-spotlight",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Board of the season"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Small label",
      "default": "Staff pick"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show short description",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#2563a8"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec rating",
      "settings": [
        {
          "type": "text",
          "id": "spec_name",
          "label": "Spec name",
          "default": "Flex"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating (1–5)",
          "default": 3
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Board spotlight",
      "blocks": [
        { "type": "spec", "settings": { "spec_name": "Flex", "rating": 3 } },
        { "type": "spec", "settings": { "spec_name": "Park", "rating": 4 } },
        { "type": "spec", "settings": { "spec_name": "Powder", "rating": 2 } }
      ]
    }
  ]
}
{% endschema %}
